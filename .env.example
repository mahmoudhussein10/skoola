# PostgreSQL
# Local development and Prisma migrations: Supabase Session Pooler (:5432).
# Serverless production: Supabase Transaction Pooler (:6543) with pgbouncer=true.
DATABASE_URL=
# Stable session/direct connection used by Prisma migrations.
DIRECT_URL=

# Supabase project and Storage (server only except SUPABASE_URL when intentionally exposed)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tenant-assets

# Authentication and canonical application URL
AUTH_SECRET=
AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
DEFAULT_TENANT_SLUG=abdelrahman-hassan

# First Super Admin. Read only by `npm run db:seed`; never hard-code these values.
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Cloudflare Stream (server-side secrets must never use NEXT_PUBLIC_)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=